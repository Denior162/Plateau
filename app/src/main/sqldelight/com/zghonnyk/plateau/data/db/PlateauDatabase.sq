selectAllSpecies:
SELECT * FROM species ORDER BY name ASC;

insertSpecies:
INSERT INTO species (name) VALUES (?);

selectAllPlantsWithSpecies:
SELECT
    plants.id,
    plants.name AS plant_name,
    plants.species_id,
    species.name AS species_name
FROM plants
LEFT JOIN species ON plants.species_id = species.id
ORDER BY plants.id DESC;

insertPlant:
INSERT INTO plants (name, species_id)
VALUES (?, ?);

deletePlant:
DELETE FROM plants WHERE id = ?;

selectMeasurementsForPlant:
SELECT * FROM measurements
WHERE plant_id = ?
ORDER BY timestamp ASC;

insertMeasurement:
INSERT INTO measurements (plant_id, timestamp, weight_grams)
VALUES (?, ?, ?);

deleteMeasurement:
DELETE FROM measurements WHERE id = ?;

updatePlant:
UPDATE plants SET name = ?, species_id = ? WHERE id = ?;

updateMeasurement:
UPDATE measurements
SET weight_grams = :weightGrams
WHERE id = :id;

selectAllMeasurements:
SELECT * FROM measurements
ORDER BY timestamp;

lastInsertRowId:
SELECT last_insert_rowid();

insertWatering:
INSERT INTO watering_sessions (plant_id, timestamp, water_volume_ml)
VALUES (?, ?, ?);

selectAllWatering:
SELECT * FROM watering_sessions
ORDER BY timestamp;

selectAllPots:
SELECT * FROM pots ORDER BY name;

insertPot:
INSERT INTO pots(name, empty_mass_grams) VALUES (?, ?);

selectAllRepottings:
SELECT r.id, r.plant_id, r.timestamp, r.pot_id, p.name AS pot_name, p.empty_mass_grams
FROM repottings r
JOIN pots p ON p.id = r.pot_id
ORDER BY r.timestamp;

insertRepotting:
INSERT INTO repottings(plant_id, timestamp, pot_id) VALUES (?, ?, ?);

deleteRepotting:
DELETE FROM repottings WHERE id = ?;

selectAllPrunings:
SELECT * FROM prunings ORDER BY timestamp;

insertPruning:
INSERT INTO prunings(plant_id, timestamp, removed_grams) VALUES (?, ?, ?);

deletePruning:
DELETE FROM prunings WHERE id = ?;