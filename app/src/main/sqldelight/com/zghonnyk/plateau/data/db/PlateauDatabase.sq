CREATE TABLE soil_types (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    acidity_ph REAL,
    components_description TEXT
);

CREATE TABLE rooms (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    window_orientation TEXT
);

CREATE TABLE species (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    family TEXT,
    common_name TEXT,
    soil_id INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    dry_down_pct REAL,
    extra_days INTEGER,
    target_pot_type TEXT CHECK (target_pot_type IN ('classic', 'cachepot', 'self_watering', 'technical')),
    watering_method TEXT CHECK (watering_method IN ('root', 'drip', 'overhead', 'subsurface', 'auto')),
    max_interval_days INTEGER CHECK (max_interval_days IS NULL OR max_interval_days > 0)
);

CREATE UNIQUE INDEX ux_species_name ON species(name);

CREATE TABLE pots (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    empty_mass_grams REAL CHECK (empty_mass_grams IS NULL OR empty_mass_grams > 0),
    material TEXT,
    diameter_cm REAL,
    volume_ml REAL,
    pot_type TEXT CHECK (pot_type IN ('classic', 'cachepot', 'self_watering', 'technical'))
);

CREATE TABLE plants (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    species_id INTEGER REFERENCES species(id) ON DELETE SET NULL ON UPDATE CASCADE,
    room_id INTEGER REFERENCES rooms(id) ON DELETE SET NULL,
    pot_id INTEGER REFERENCES pots(id) ON DELETE SET NULL,
    acquisition_date INTEGER NOT NULL,
    notes TEXT,
    archived_at INTEGER,
    measurement_noise_grams REAL CHECK (measurement_noise_grams IS NULL OR measurement_noise_grams > 0)
);

CREATE INDEX idx_plants_species ON plants(species_id);

CREATE TABLE measurements (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE ON UPDATE CASCADE,
    timestamp INTEGER NOT NULL,
    weight_grams REAL NOT NULL,
    excluded INTEGER NOT NULL DEFAULT 0 CHECK (excluded IN (0, 1))
);

CREATE INDEX idx_measurements_plant ON measurements(plant_id);

CREATE UNIQUE INDEX ux_measurements_plant_ts ON measurements(plant_id, timestamp);

CREATE TABLE watering_sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE ON UPDATE CASCADE,
    timestamp INTEGER NOT NULL,
    water_volume_ml REAL
);

CREATE INDEX idx_watering_plant ON watering_sessions(plant_id);

CREATE TABLE repotting_events (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id   INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp  INTEGER NOT NULL,
    new_pot_id INTEGER NOT NULL REFERENCES pots(id),
    soil_id    INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    reason     TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE INDEX idx_repotting_events_new_pot ON repotting_events(new_pot_id);

CREATE TABLE mass_removal_events (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id      INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp     INTEGER NOT NULL,
    removed_grams REAL CHECK (removed_grams IS NULL OR removed_grams > 0),
    event_type    TEXT NOT NULL DEFAULT 'pruning',
    notes         TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE TABLE plant_photos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp INTEGER NOT NULL,
    file_path TEXT NOT NULL,
    caption TEXT
);

CREATE INDEX idx_photos_plant ON plant_photos(plant_id);

CREATE TABLE soil_addition_events (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id    INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp   INTEGER NOT NULL,
    added_grams REAL CHECK (added_grams IS NULL OR added_grams > 0),
    soil_id     INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    notes       TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE INDEX idx_soil_addition_soil ON soil_addition_events(soil_id);
insertPhoto:
INSERT INTO plant_photos(plant_id, timestamp, file_path, caption)
VALUES (?, ?, ?, ?);

selectPhotosByPlant:
SELECT * FROM plant_photos WHERE plant_id = ? ORDER BY timestamp DESC;

selectAllPhotos:
SELECT * FROM plant_photos ORDER BY timestamp ASC;

selectLatestPhotoPerPlant:
SELECT * FROM plant_photos
WHERE id IN (SELECT MAX(id) FROM plant_photos GROUP BY plant_id);

deletePhoto:
DELETE FROM plant_photos WHERE id = ?;

updatePhotoCaption:
UPDATE plant_photos SET caption = ? WHERE id = ?;

selectAllSpecies:
SELECT * FROM species ORDER BY name ASC;

insertSpecies:
INSERT INTO species (name) VALUES (?);

selectAllPlantsWithSpecies:
SELECT
    plants.id,
    plants.name AS plant_name,
    plants.species_id,
    species.name AS species_name
FROM plants
LEFT JOIN species ON plants.species_id = species.id
ORDER BY plants.id DESC;

insertPlant:
INSERT INTO plants (name, species_id, acquisition_date)
VALUES (?, ?, ?);

selectLastInsertRowId:
SELECT last_insert_rowid();

deletePlant:
DELETE FROM plants WHERE id = ?;

selectMeasurementsForPlant:
SELECT * FROM measurements
WHERE plant_id = ?
ORDER BY timestamp ASC;

insertMeasurement:
INSERT INTO measurements (plant_id, timestamp, weight_grams)
VALUES (?, ?, ?);

deleteMeasurement:
DELETE FROM measurements WHERE id = ?;

updatePlant:
UPDATE plants SET name = ?, species_id = ? WHERE id = ?;

updateMeasurement:
UPDATE measurements
SET weight_grams = :weightGrams
WHERE id = :id;

selectAllMeasurements:
SELECT * FROM measurements
ORDER BY timestamp;

lastInsertRowId:
SELECT last_insert_rowid();

insertWatering:
INSERT INTO watering_sessions (plant_id, timestamp, water_volume_ml)
VALUES (?, ?, ?);

selectAllWatering:
SELECT * FROM watering_sessions
ORDER BY timestamp;

selectWateringsForPlant:
SELECT * FROM watering_sessions WHERE plant_id = ?;

selectAllPots:
SELECT * FROM pots ORDER BY name;

insertPot:
INSERT INTO pots(name, empty_mass_grams) VALUES (?, ?);

selectAllRepottings:
SELECT r.id, r.plant_id, r.timestamp, r.new_pot_id AS pot_id, p.name AS pot_name, p.empty_mass_grams
FROM repotting_events r
JOIN pots p ON p.id = r.new_pot_id
ORDER BY r.timestamp;

insertRepotting:
INSERT INTO repotting_events(plant_id, timestamp, new_pot_id) VALUES (?, ?, ?);

deleteRepotting:
DELETE FROM repotting_events WHERE id = ?;

selectAllPrunings:
SELECT * FROM mass_removal_events ORDER BY timestamp;

insertPruning:
INSERT INTO mass_removal_events(plant_id, timestamp, removed_grams) VALUES (?, ?, ?);

deletePruning:
DELETE FROM mass_removal_events WHERE id = ?;

selectAllSoilAdditions:
SELECT * FROM soil_addition_events ORDER BY timestamp;

insertSoilAddition:
INSERT INTO soil_addition_events(plant_id, timestamp, added_grams, soil_id, notes) VALUES (?, ?, ?, ?, ?);

deleteSoilAddition:
DELETE FROM soil_addition_events WHERE id = ?;

insertRemoval:
INSERT INTO mass_removal_events(plant_id, timestamp, removed_grams, event_type, notes)
VALUES (?, ?, ?, ?, ?);

insertRoom:
INSERT INTO rooms(name, window_orientation)
VALUES (?, ?);

insertSoil:
INSERT INTO soil_types(name, acidity_ph, components_description)
VALUES (?, ?, ?);

selectAllSoilTypes:
SELECT name, id FROM soil_types;

selectAllRooms:
SELECT name, id FROM rooms;

selectAllWateringSessions:
SELECT plant_id, timestamp FROM watering_sessions;

selectAllMassRemovalEvents:
SELECT plant_id, timestamp FROM mass_removal_events;

selectAllSoilAdditionEvents:
SELECT plant_id, timestamp FROM soil_addition_events;

selectAllRepottingEvents:
SELECT plant_id, timestamp FROM repotting_events;

insertPotFull:
INSERT INTO pots(name, empty_mass_grams, material, diameter_cm, volume_ml, pot_type)
VALUES (?, ?, ?, ?, ?, ?);

insertSpeciesFull:
INSERT INTO species(name, family, common_name, soil_id, dry_down_pct, extra_days, target_pot_type, watering_method, max_interval_days)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertPlantFull:
INSERT INTO plants(name, species_id, room_id, pot_id, notes, acquisition_date, archived_at, measurement_noise_grams)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertMeasurementFull:
INSERT INTO measurements(plant_id, timestamp, weight_grams, excluded)
VALUES (?, ?, ?, ?);

insertRepottingFull:
INSERT INTO repotting_events(plant_id, timestamp, new_pot_id, soil_id, reason)
VALUES (?, ?, ?, ?, ?);

updateWatering:
UPDATE watering_sessions SET water_volume_ml = :volumeMl WHERE id = :id;

deleteWatering:
DELETE FROM watering_sessions WHERE id = ?;

updateWateringTimestamp:
UPDATE watering_sessions SET timestamp = :new, water_volume_ml = :volumeMl WHERE id = :id;

moveMeasurementAt:
UPDATE measurements SET timestamp = :new WHERE plant_id = :plantId AND timestamp = :old;

updateMeasurementWeightAndTime:
UPDATE measurements SET weight_grams = :weightGrams, timestamp = :timestamp WHERE id = :id;

getTotalEvaporatedBySpecies:
WITH WeightDrops AS (
    SELECT
        m.plant_id,
        m.weight_grams AS current_weight,
        (SELECT m_prev.weight_grams
         FROM measurements m_prev
         WHERE m_prev.plant_id = m.plant_id
           AND m_prev.timestamp < m.timestamp
           AND m_prev.excluded = 0
         ORDER BY m_prev.timestamp DESC LIMIT 1) AS prev_weight
    FROM measurements m
    WHERE m.excluded = 0
)
SELECT COALESCE(ROUND(SUM(wd.prev_weight - wd.current_weight), 1), 0.0) AS total_evaporated_grams
FROM WeightDrops wd
JOIN plants p ON wd.plant_id = p.id
JOIN species s ON p.species_id = s.id
WHERE s.id = :speciesId
  AND p.archived_at IS NULL
  AND wd.prev_weight > wd.current_weight;

  getPlantsWithMinPeakWeight:
  SELECT
      p.id,
      p.name AS plant_name,
      s.name AS species_name,
      MAX(m.weight_grams) AS peak_weight,
      COUNT(m.id) AS total_measurements
  FROM plants p
  LEFT JOIN species s ON p.species_id = s.id
  JOIN measurements m ON p.id = m.plant_id
  WHERE m.excluded = 0
    AND p.archived_at IS NULL
  GROUP BY p.id, p.name, s.name
  HAVING MAX(m.weight_grams) >= :minWeight
  ORDER BY peak_weight DESC;

  getSpeciesMeasurementStats:
  SELECT
      s.name AS species_name,
      COUNT(DISTINCT p.id) AS active_plants_count,
      COUNT(m.id) AS total_measurements,
      ROUND(AVG(m.weight_grams), 1) AS avg_weight_grams,
      MAX(m.weight_grams) AS max_weight_grams
  FROM species s
  JOIN plants p ON p.species_id = s.id
  JOIN measurements m ON m.plant_id = p.id
  WHERE m.excluded = 0
    AND p.archived_at IS NULL
  GROUP BY s.id, s.name
  HAVING COUNT(m.id) >= 2
  ORDER BY active_plants_count DESC, total_measurements DESC;

  getGlobalMedianDailyEvaporation:
  WITH MeasurementLags AS (
      SELECT
          m.plant_id,
          m.weight_grams AS current_weight,
          m.timestamp AS current_ts,
          LAG(m.weight_grams) OVER (PARTITION BY m.plant_id ORDER BY m.timestamp) AS prev_weight,
          LAG(m.timestamp) OVER (PARTITION BY m.plant_id ORDER BY m.timestamp) AS prev_ts
      FROM measurements m
      WHERE m.excluded = 0
  ),
  DailyRates AS (
      SELECT
          (ml.prev_weight - ml.current_weight) / (CAST(ml.current_ts - ml.prev_ts AS REAL) / 86400000.0) AS rate_per_day
      FROM MeasurementLags ml
      JOIN plants p ON ml.plant_id = p.id
      JOIN species s ON p.species_id = s.id
      WHERE ml.prev_weight > ml.current_weight
              AND ml.current_ts > ml.prev_ts
        AND p.archived_at IS NULL
  ),
  OrderedRates AS (
      SELECT
          rate_per_day,
          ROW_NUMBER() OVER (ORDER BY rate_per_day) AS rn,
          COUNT(*) OVER () AS total_count
      FROM DailyRates
  )
  SELECT COALESCE(ROUND(AVG(rate_per_day), 1), 0.0) AS median_evaporation_per_day
  FROM OrderedRates
  WHERE rn IN ((total_count + 1) / 2, (total_count + 2) / 2);

  getMonthlyMeasurementStats:
  SELECT
      strftime('%Y-%m', m.timestamp / 1000, 'unixepoch', 'localtime') AS month_year,
      COUNT(m.id) AS total_measurements,
      ROUND(AVG(m.weight_grams), 1) AS avg_weight_grams,
      MAX(m.weight_grams) AS max_weight_recorded
  FROM measurements m
  WHERE m.excluded = 0
  GROUP BY month_year
  ORDER BY month_year DESC;

selectPlantOverview:
SELECT
    p.id,
    p.name AS plant_name,
    p.species_id,
    s.name AS species_name,
    lm.timestamp AS last_weighed_at,
    CAST(EXISTS (SELECT 1 FROM watering_sessions w WHERE w.plant_id = p.id) AS INTEGER) AS has_watering,
    ph.file_path AS photo_path,
    po.empty_mass_grams AS tare_grams
FROM plants p
LEFT JOIN species s ON s.id = p.species_id
LEFT JOIN measurements lm ON lm.id = (
    SELECT m.id FROM measurements m
    WHERE m.plant_id = p.id AND m.excluded = 0
    ORDER BY m.timestamp DESC LIMIT 1
)
LEFT JOIN plant_photos ph ON ph.id = (
    SELECT x.id FROM plant_photos x
    WHERE x.plant_id = p.id
    ORDER BY x.timestamp DESC, x.id DESC LIMIT 1
)
LEFT JOIN repotting_events r ON r.id = (
    SELECT y.id FROM repotting_events y
    WHERE y.plant_id = p.id
    ORDER BY y.timestamp DESC LIMIT 1
)
LEFT JOIN pots po ON po.id = r.new_pot_id
ORDER BY p.id DESC;

selectActivePhaseMeasurements:
WITH last_event AS (
      SELECT plant_id, MAX(ts) AS ts FROM (
          SELECT plant_id, timestamp AS ts FROM watering_sessions
          UNION ALL
          SELECT plant_id, timestamp FROM mass_removal_events
          UNION ALL
          SELECT plant_id, timestamp FROM repotting_events
      ) GROUP BY plant_id
  )
  SELECT m.id, m.plant_id, m.timestamp, m.weight_grams
  FROM measurements m
  LEFT JOIN last_event e ON e.plant_id = m.plant_id
  WHERE m.excluded = 0
    AND m.timestamp >= COALESCE(e.ts, 0)
  ORDER BY m.plant_id, m.timestamp;

