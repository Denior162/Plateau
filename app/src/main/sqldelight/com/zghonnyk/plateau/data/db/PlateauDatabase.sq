CREATE TABLE soil_types (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    acidity_ph REAL,
    components_description TEXT
);

CREATE TABLE rooms (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    window_orientation TEXT
);

CREATE TABLE species (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    family TEXT,
    common_name TEXT,
    soil_id INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    dry_down_pct REAL,
    extra_days INTEGER,
    target_pot_type TEXT CHECK (target_pot_type IN ('classic', 'cachepot', 'self_watering', 'technical')),
    watering_method TEXT CHECK (watering_method IN ('root', 'drip', 'overhead', 'subsurface', 'auto')),
    max_interval_days INTEGER CHECK (max_interval_days IS NULL OR max_interval_days > 0)
);

CREATE UNIQUE INDEX ux_species_name ON species(name);

CREATE TABLE pots (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    empty_mass_grams REAL CHECK (empty_mass_grams IS NULL OR empty_mass_grams > 0),
    material TEXT,
    diameter_cm REAL,
    volume_ml REAL,
    pot_type TEXT CHECK (pot_type IN ('classic', 'cachepot', 'self_watering', 'technical'))
);

CREATE TABLE plants (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    species_id INTEGER REFERENCES species(id) ON DELETE SET NULL ON UPDATE CASCADE,
    room_id INTEGER REFERENCES rooms(id) ON DELETE SET NULL,
    pot_id INTEGER REFERENCES pots(id) ON DELETE SET NULL,
    acquisition_date INTEGER NOT NULL,
    notes TEXT,
    archived_at INTEGER,
    measurement_noise_grams REAL CHECK (measurement_noise_grams IS NULL OR measurement_noise_grams > 0)
);

CREATE INDEX idx_plants_species ON plants(species_id);

CREATE TABLE measurements (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE ON UPDATE CASCADE,
    timestamp INTEGER NOT NULL,
    weight_grams REAL NOT NULL,
    excluded INTEGER NOT NULL DEFAULT 0 CHECK (excluded IN (0, 1))
);

CREATE INDEX idx_measurements_plant ON measurements(plant_id);

CREATE UNIQUE INDEX ux_measurements_plant_ts ON measurements(plant_id, timestamp);

CREATE TABLE watering_sessions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE ON UPDATE CASCADE,
    timestamp INTEGER NOT NULL,
    water_volume_ml REAL
);

CREATE INDEX idx_watering_plant ON watering_sessions(plant_id);

CREATE TABLE repotting_events (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id   INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp  INTEGER NOT NULL,
    new_pot_id INTEGER NOT NULL REFERENCES pots(id),
    soil_id    INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    reason     TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE INDEX idx_repotting_events_new_pot ON repotting_events(new_pot_id);

CREATE TABLE mass_removal_events (
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id      INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp     INTEGER NOT NULL,
    removed_grams REAL CHECK (removed_grams IS NULL OR removed_grams > 0),
    event_type    TEXT NOT NULL DEFAULT 'pruning',
    notes         TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE TABLE plant_photos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp INTEGER NOT NULL,
    file_path TEXT NOT NULL,
    caption TEXT
);

CREATE INDEX idx_photos_plant ON plant_photos(plant_id);

CREATE TABLE soil_addition_events (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id    INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp   INTEGER NOT NULL,
    added_grams REAL CHECK (added_grams IS NULL OR added_grams > 0),
    soil_id     INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    notes       TEXT,
    UNIQUE (plant_id, timestamp)
);

CREATE INDEX idx_soil_addition_soil ON soil_addition_events(soil_id);

selectAllSpecies:
SELECT * FROM species ORDER BY name ASC;

insertSpecies:
INSERT INTO species (name) VALUES (?);

selectAllPlantsWithSpecies:
SELECT
    plants.id,
    plants.name AS plant_name,
    plants.species_id,
    species.name AS species_name
FROM plants
LEFT JOIN species ON plants.species_id = species.id
ORDER BY plants.id DESC;

insertPlant:
INSERT INTO plants (name, species_id, acquisition_date)
VALUES (?, ?, ?);

deletePlant:
DELETE FROM plants WHERE id = ?;

selectMeasurementsForPlant:
SELECT * FROM measurements
WHERE plant_id = ?
ORDER BY timestamp ASC;

insertMeasurement:
INSERT INTO measurements (plant_id, timestamp, weight_grams)
VALUES (?, ?, ?);

deleteMeasurement:
DELETE FROM measurements WHERE id = ?;

updatePlant:
UPDATE plants SET name = ?, species_id = ? WHERE id = ?;

updateMeasurement:
UPDATE measurements
SET weight_grams = :weightGrams
WHERE id = :id;

selectAllMeasurements:
SELECT * FROM measurements
ORDER BY timestamp;

lastInsertRowId:
SELECT last_insert_rowid();

insertWatering:
INSERT INTO watering_sessions (plant_id, timestamp, water_volume_ml)
VALUES (?, ?, ?);

selectAllWatering:
SELECT * FROM watering_sessions
ORDER BY timestamp;

selectAllPots:
SELECT * FROM pots ORDER BY name;

insertPot:
INSERT INTO pots(name, empty_mass_grams) VALUES (?, ?);

selectAllRepottings:
SELECT r.id, r.plant_id, r.timestamp, r.new_pot_id AS pot_id, p.name AS pot_name, p.empty_mass_grams
FROM repotting_events r
JOIN pots p ON p.id = r.new_pot_id
ORDER BY r.timestamp;

insertRepotting:
INSERT INTO repotting_events(plant_id, timestamp, new_pot_id) VALUES (?, ?, ?);

deleteRepotting:
DELETE FROM repotting_events WHERE id = ?;

selectAllPrunings:
SELECT * FROM mass_removal_events ORDER BY timestamp;

insertPruning:
INSERT INTO mass_removal_events(plant_id, timestamp, removed_grams) VALUES (?, ?, ?);

deletePruning:
DELETE FROM mass_removal_events WHERE id = ?;

selectAllSoilAdditions:
SELECT * FROM soil_addition_events ORDER BY timestamp;

insertSoilAddition:
INSERT INTO soil_addition_events(plant_id, timestamp, added_grams, soil_id, notes) VALUES (?, ?, ?, ?, ?);

deleteSoilAddition:
DELETE FROM soil_addition_events WHERE id = ?;

insertRemoval:
INSERT INTO mass_removal_events(plant_id, timestamp, removed_grams, event_type, notes)
VALUES (?, ?, ?, ?, ?);

insertRoom:
INSERT INTO rooms(name, window_orientation)
VALUES (?, ?);

insertSoil:
INSERT INTO soil_types(name, acidity_ph, components_description)
VALUES (?, ?, ?);

selectAllSoilTypes:
SELECT name, id FROM soil_types;

selectAllRooms:
SELECT name, id FROM rooms;

selectAllWateringSessions:
SELECT plant_id, timestamp FROM watering_sessions;

selectAllMassRemovalEvents:
SELECT plant_id, timestamp FROM mass_removal_events;

selectAllSoilAdditionEvents:
SELECT plant_id, timestamp FROM soil_addition_events;

selectAllRepottingEvents:
SELECT plant_id, timestamp FROM repotting_events;

insertPotFull:
INSERT INTO pots(name, empty_mass_grams, material, diameter_cm, volume_ml, pot_type)
VALUES (?, ?, ?, ?, ?, ?);

insertSpeciesFull:
INSERT INTO species(name, family, common_name, soil_id, dry_down_pct, extra_days, target_pot_type, watering_method, max_interval_days)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertPlantFull:
INSERT INTO plants(name, species_id, room_id, pot_id, notes, acquisition_date, archived_at, measurement_noise_grams)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertMeasurementFull:
INSERT INTO measurements(plant_id, timestamp, weight_grams, excluded)
VALUES (?, ?, ?, ?);

insertRepottingFull:
INSERT INTO repotting_events(plant_id, timestamp, new_pot_id, soil_id, reason)
VALUES (?, ?, ?, ?, ?);

updateWatering:
UPDATE watering_sessions SET water_volume_ml = :volumeMl WHERE id = :id;

deleteWatering:
DELETE FROM watering_sessions WHERE id = ?;

updateWateringTimestamp:
UPDATE watering_sessions SET timestamp = :new, water_volume_ml = :volumeMl WHERE id = :id;

moveMeasurementAt:
UPDATE measurements SET timestamp = :new WHERE plant_id = :plantId AND timestamp = :old;

updateMeasurementWeightAndTime:
UPDATE measurements SET weight_grams = :weightGrams, timestamp = :timestamp WHERE id = :id;