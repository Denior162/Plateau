ALTER TABLE measurements ADD COLUMN excluded INTEGER NOT NULL DEFAULT 0 CHECK (excluded IN (0, 1));
ALTER TABLE plants ADD COLUMN archived_at INTEGER;
ALTER TABLE plants ADD COLUMN measurement_noise_grams REAL
    CHECK (measurement_noise_grams IS NULL OR measurement_noise_grams > 0);
ALTER TABLE species ADD COLUMN max_interval_days INTEGER
    CHECK (max_interval_days IS NULL OR max_interval_days > 0);

CREATE TABLE repotting_events_new (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    plant_id   INTEGER NOT NULL REFERENCES plants(id) ON DELETE CASCADE,
    timestamp  INTEGER NOT NULL,
    new_pot_id INTEGER NOT NULL REFERENCES pots(id),
    soil_id    INTEGER REFERENCES soil_types(id) ON DELETE SET NULL,
    reason     TEXT,
    UNIQUE (plant_id, timestamp)
);

INSERT INTO repotting_events_new(id, plant_id, timestamp, new_pot_id, soil_id)
SELECT id, plant_id, timestamp, new_pot_id, soil_id FROM repotting_events;

INSERT INTO repotting_events_new(plant_id, timestamp, new_pot_id)
SELECT r.plant_id,
       min(r.timestamp,
           COALESCE((SELECT MIN(m.timestamp) FROM measurements m
                     WHERE m.plant_id = r.plant_id), r.timestamp)) - 1,
       r.old_pot_id
FROM repotting_events r
WHERE r.old_pot_id IS NOT NULL
  AND r.timestamp = (SELECT MIN(r2.timestamp) FROM repotting_events r2
                     WHERE r2.plant_id = r.plant_id);

DROP TABLE repotting_events;
ALTER TABLE repotting_events_new RENAME TO repotting_events;
CREATE INDEX idx_repotting_events_new_pot ON repotting_events(new_pot_id);